pipeline {
    agent any
    stages {
        stage('Construcción (Build)') {
            steps {
                echo 'Preparando y construyendo la aplicación...'
            }
        }
        stage('Pruebas (Test)') {
            steps {
                echo 'Probando la conexión simulada al puerto 5050...'
            }
        }
        stage('Despliegue (Deploy)') {
            steps {
                echo '¡Despliegue exitoso!'
            }
        }
    }
}
